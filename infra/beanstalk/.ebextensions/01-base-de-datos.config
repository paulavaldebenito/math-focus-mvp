# Migraciones y banco de ejercicios en cada despliegue (specs/025).
#
# `container_commands` corre en /var/app/staging después de `npm install` y antes de cambiar a
# la versión nueva. `leader_only: true`: con varias instancias corre en una sola. Si el comando
# sale con error, Elastic Beanstalk cancela el despliegue y la versión anterior sigue sirviendo.
#
# No usar despliegues «Immutable» ni «Traffic splitting»: en esos modos no hay líder y los
# comandos leader_only no corren (las migraciones no se aplicarían).
container_commands:
  01_migrar_y_sembrar_banco:
    command: "bash scripts-eb/migrar-y-sembrar.sh"
    leader_only: true
