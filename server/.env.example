# Copiar a .env para desarrollo local. Nunca commitear .env real.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
PORT=4100
CLIENT_ORIGIN="http://localhost:5173"
# Solo con `prisma dev` (PGlite, una única sesión para todas las conexiones): con más de una
# conexión las consultas simultáneas se pisan. Con Postgres real (CI, AWS) no se define.
PG_POOL_MAX=1
SESSION_SECRET="reemplazar-con-un-valor-propio-y-secreto"
# Cuentas con acceso al modo revisión (todos los cursos, respuestas y
# comentarios por pregunta), separadas por coma. Vacío = nadie.
REVIEWER_EMAILS="revisora@example.com"
