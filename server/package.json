{
  "name": "math-focus-mvp-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "bank:images": "tsx prisma/integrar-banco-imagenes.ts",
    "bank:ids": "tsx prisma/seed/ids/exportar-ids.ts",
    "demo:colegio": "tsx prisma/demo/colegio-demo.ts",
    "bank:calidad": "tsx prisma/calidad/revisarCalidad.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.10.1",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
