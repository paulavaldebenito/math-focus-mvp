// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Adulto responsable (apoderado/docente) — único rol con credenciales en el MVP.
model AdultUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  consents     Consent[]
  children     ChildProfile[]
  reviewComments ReviewComment[]
  staffMemberships SchoolStaff[]
  teacherNotes   TeacherNote[]
}

/// Consentimiento explícito de un adulto. Es obligatorio y precede a la
/// creación de cualquier perfil infantil (ver relación 1-a-1 en ChildProfile).
model Consent {
  id           String        @id @default(cuid())
  adultUserId  String
  adultUser    AdultUser     @relation(fields: [adultUserId], references: [id])
  scope        String
  grantedAt    DateTime      @default(now())
  revokedAt    DateTime?
  childProfile ChildProfile?
}

/// Perfil del estudiante. Datos mínimos: sin diagnósticos ni datos de salud.
model ChildProfile {
  id                String             @id @default(cuid())
  adultUserId       String
  adultUser         AdultUser          @relation(fields: [adultUserId], references: [id])
  consentId         String             @unique
  consent           Consent            @relation(fields: [consentId], references: [id])
  displayName       String
  /// MVP v1: fijo en 1° básico. Se guarda el valor real igualmente para no
  /// tener que migrar el esquema cuando se habiliten otros cursos.
  grade             Int
  language          String             @default("es")
  /// Clave fija de un catálogo cerrado (ver COMPANION_KEYS en el servidor).
  /// Nullable: un perfil recién creado todavía no lo eligió.
  companion         String?
  /// Nombre propio que el niño le puso a su mascota (p. ej. "Pelusa") — nunca
  /// se modera/valida el contenido más allá de largo, es un nombre inventado
  /// por el niño para su personaje, no un dato público ni compartido con
  /// otros niños. Nullable: sin nombre propio, la UI usa el nombre por
  /// defecto del personaje (ver companions.ts).
  mascotName        String?
  /// Nombre propio que el niño le puso a CADA mascota, por clave del
  /// catálogo ({ "zorro": "Pelusa", "buho": "Sabio" }). Así, al cambiar de
  /// mascota y volver, recupera el nombre que ya le había puesto.
  /// `mascotName` sigue siendo el nombre de la mascota ACTUAL.
  mascotNames       Json               @default("{}")
  /// Claves de un catálogo cerrado (ver INTEREST_KEYS en el servidor). De 1 a
  /// MAX_INTERESTS al elegir; vacío = un perfil recién creado (o anterior a
  /// esta funcionalidad) que todavía no eligió.
  interests         String[]           @default([])
  createdAt         DateTime           @default(now())
  sessions          Session[]
  progressSnapshots ProgressSnapshot[]
  starEvents        StarEvent[]
  checkIns          WellbeingCheckIn[]
  reflections    SessionReflection[]
  homeGamePlays  HomeGamePlay[]
  enrollments    ClassEnrollment[]
  teacherNotes   TeacherNote[]
}

/// Patrón de error OBSERVABLE (nunca un diagnóstico clínico). Catálogo fijo,
/// sembrado por seed — ver regla del proyecto: "no interpretar un error como
/// prueba de déficit atencional".
model ErrorType {
  id          String           @id @default(cuid())
  code        String           @unique
  label       String
  description String
  /// Nivel del error (modelo matefriendly): 1=conceptual, 2=procedimental,
  /// 3=lectura/comprensión del enunciado. NULL para los patrones de
  /// comportamiento (respuesta_rapida/abandono/solicitud_ayuda_repetida),
  /// que no son "por qué esta alternativa está mal" sino señales de sesión.
  level       Int?
  options     ExerciseOption[]
  attempts    Attempt[]
}

/// Habilidad matemática. MVP v1: fija en 1° básico, eje Números y operaciones.
model MathSkill {
  id        String     @id @default(cuid())
  grade     Int
  axis      String
  name      String
  /// Traducción al inglés del eje/nombre de la habilidad — se muestran en el
  /// mapa de aprendizaje. Nullable: no todas las habilidades la tienen
  /// todavía — el cliente cae de vuelta al español si falta (mismo patrón
  /// que Exercise.promptEn). Debe usar el vocabulario escolar real en inglés
  /// (p. ej. "pie chart", no una traducción literal), no una traducción
  /// palabra por palabra.
  axisEn    String?
  nameEn    String?
  /// Código de Objetivo de Aprendizaje. NULL a propósito: no existe una fuente
  /// curricular oficial verificada en este entorno. No completar sin validar
  /// contra el documento oficial de MINEDUC.
  oaCode    String?
  /// Orden dentro de su curso — posición en el mapa de habilidades (un
  /// contenido se desbloquea al completar el anterior). Lo asigna el seed
  /// según el orden en que cada agente de curso escribió sus contenidos.
  order     Int        @default(0)
  exercises Exercise[]
  sessions  Session[]
  reflections SessionReflection[]
  homeGamePlays HomeGamePlay[]
}

/// Ejercicio. `isFictitious` marca explícitamente los datos de prueba —
/// nunca se presentan como contenido curricular real sin revisión.
model Exercise {
  id              String           @id @default(cuid())
  mathSkillId     String
  mathSkill       MathSkill        @relation(fields: [mathSkillId], references: [id])
  prompt          String
  /// Traducción al inglés del enunciado. Nullable: no todo ejercicio tiene
  /// una todavía — el cliente cae de vuelta al español si falta.
  promptEn        String?
  /// Procedimiento o justificación esperada — trazabilidad pedagógica
  /// exigida por el proyecto para cada ejercicio.
  procedureNote   String
  procedureNoteEn String?
  /// Nivel de dificultad 1-3, usado por el motor adaptativo para pedir un
  /// ejercicio más fácil o más difícil. No confundir con `grade`.
  difficultyLevel Int              @default(2)
  isFictitious    Boolean          @default(true)
  /// Representación concreta/pictórica del ejercicio (grupos de objetos a
  /// combinar o a quitar) — para niños de 1° básico que aún no leen con
  /// soltura. Nullable: no todo ejercicio antiguo tiene una todavía.
  visual          Json?
  /// Ilustración SVG del banco de imágenes por curso, una por idioma:
  /// { kind, width, height, src: { es, en }, alt: { es, en } } — rutas
  /// públicas del cliente (client/public/banco-imagenes). Si está presente,
  /// reemplaza a `visual` en la interfaz; el enunciado se sigue mostrando
  /// como texto. Nullable: la mayoría de los ejercicios no tiene imagen y
  /// conserva su representación actual. La vincula
  /// prisma/seed/imagenes/linkImages.ts, nunca a mano.
  image           Json?
  /// Tema de un catálogo cerrado (ver INTEREST_KEYS en el servidor) que
  /// reescribe el enunciado con vocabulario de ese interés. Nullable: NULL
  /// significa contenido neutro/existente, usado siempre como respaldo.
  theme           String?
  /// Agrupa un ejercicio base con sus variantes temáticas (mismo problema,
  /// otra historia). Sirve para no entregar dos veces el "mismo" problema en
  /// una sesión. NULL = sin variantes.
  baseKey         String?
  /// Desarrollo paso a paso de la solución correcta: [{ es, en }] (specs/015).
  /// Sin la historia, para que sirva a todas las variantes del problema. Se
  /// envía SOLO después de responder (antes delataría la respuesta). Lo
  /// escribe prisma/seed/traducciones/applyWorkedSteps.ts. NULL = sin desarrollo.
  solution        Json?
  /// Retirado del banco por la revisión pedagógica (specs/017): ya no se
  /// entrega en práctica, evaluación ni revisión, pero se conserva por los
  /// intentos que lo referencian. Lo marca prisma/seed/traducciones/
  /// applyRetirements.ts desde ejercicios_retirados.json, nunca a mano.
  retired         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  options         ExerciseOption[]
  attempts        Attempt[]
  reviewComments  ReviewComment[]
}

/// Alternativa de un ejercicio. Si es incorrecta, puede señalar qué patrón
/// de error observable representa (opcional: no todas las opciones erróneas
/// están clasificadas todavía).
model ExerciseOption {
  id          String     @id @default(cuid())
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id])
  label       String
  /// Traducción al inglés de la alternativa. Nullable: la mayoría son
  /// números o expresiones que no cambian entre idiomas — el cliente cae de
  /// vuelta a `label` si falta (mismo patrón que Exercise.promptEn).
  labelEn     String?
  isCorrect   Boolean
  /// Mensaje propio de esta alternativa, que el niño ve DESPUÉS de elegirla
  /// (nunca se envía con la pregunta: delataría cuáles son incorrectas).
  /// Nullable: la mayoría del banco no lo tiene — el cliente cae de vuelta
  /// al mensaje genérico del tipo de error (ERROR_FEEDBACK) o de acierto.
  /// Lo escribe prisma/seed/traducciones/applyOptionFeedback.ts.
  feedback    String?
  feedbackEn  String?
  /// Para una alternativa incorrecta: en qué paso de `Exercise.solution` se
  /// desvía y cómo queda ese paso hecho con el error, { step, es, en }
  /// (specs/015). Sirve para mostrarle al niño dónde se equivocó y para la
  /// ronda "encuentra el paso equivocado". NULL = sin desarrollo.
  wrongStep   Json?
  errorTypeId String?
  errorType   ErrorType? @relation(fields: [errorTypeId], references: [id])
  attempts    Attempt[]
}

/// Una práctica corta (5-10 min) de un niño. Contenedor de intentos, pausas
/// y decisiones adaptativas.
model Session {
  id                String             @id @default(cuid())
  childProfileId    String
  childProfile      ChildProfile       @relation(fields: [childProfileId], references: [id])
  /// Habilidad del mapa que se está practicando en esta sesión (mapa de
  /// habilidades estilo Duolingo). NULL = sesión de todo el curso (solo
  /// ocurre en sesiones creadas antes de esta funcionalidad).
  mathSkillId       String?
  mathSkill         MathSkill?         @relation(fields: [mathSkillId], references: [id])
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  attempts          Attempt[]
  pauseEvents       PauseEvent[]
  adaptiveDecisions AdaptiveDecision[]
  starEvents        StarEvent[]
  checkIns          WellbeingCheckIn[]
  reflection        SessionReflection?
}

/// Un intento de respuesta a un ejercicio dentro de una sesión.
/// `responseTimeMs` registra el patrón observable "respuesta excesivamente
/// rápida" sin interpretarlo como impulsividad ni déficit atencional.
model Attempt {
  id               String          @id @default(cuid())
  sessionId        String
  session          Session         @relation(fields: [sessionId], references: [id])
  exerciseId       String
  exercise         Exercise        @relation(fields: [exerciseId], references: [id])
  selectedOptionId String?
  selectedOption   ExerciseOption? @relation(fields: [selectedOptionId], references: [id])
  isCorrect        Boolean
  errorTypeId      String?
  errorType        ErrorType?      @relation(fields: [errorTypeId], references: [id])
  responseTimeMs   Int?
  attemptNumber    Int             @default(1)
  /// true si esta fila es de una ronda "detecta el error" (el niño
  /// diagnostica una respuesta ajena ya errada) y no de resolver el
  /// ejercicio — se excluye del historial que ve el motor adaptativo
  /// (evaluateAdaptiveRules) y de las estadísticas de precisión del panel
  /// familiar: es una habilidad distinta (diagnóstico) de la que esas dos
  /// cosas miden (resolver problemas). `selectedOptionId`/`errorTypeId`
  /// quedan NULL en estas filas — no hubo una alternativa numérica elegida.
  isSpotError      Boolean         @default(false)
  /// Cantidad de pistas usadas en este intento — insumo directo del motor
  /// adaptativo (regla "uso repetido de pistas").
  hintsUsed        Int             @default(0)
  createdAt        DateTime        @default(now())
  hints            Hint[]
}

/// Pista mostrada durante un intento. Progresiva: `level` 1, 2, 3…
model Hint {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  level     Int
  text      String
  shownAt   DateTime @default(now())
}

/// Pausa activa ofrecida durante una sesión. Siempre opcional — `accepted`
/// puede ser falso, la app nunca bloquea ni castiga por rechazarla.
model PauseEvent {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  kind       String
  offeredAt  DateTime @default(now())
  accepted   Boolean  @default(true)
  durationMs Int?
  /// Ejercicio concreto de la pausa (clave del catálogo del cliente, p. ej.
  /// "globo" o "saltos-estrella"). Nullable: pausas rechazadas o anteriores
  /// a este campo. Sirve para no repetir el mismo ejercicio en una sesión.
  exerciseKey String?
}

/// Autorreporte breve y OPCIONAL del niño al empezar una práctica, con 5
/// caritas: cómo se siente hoy y cómo se siente con las matemáticas. Nunca
/// es un diagnóstico ni se interpreta clínicamente; no se muestra a otros
/// niños ni afecta el motor adaptativo. Se guarda para, a futuro, cruzarlo
/// con el rendimiento de la misma sesión (p. ej. una baja de precisión).
model WellbeingCheckIn {
  id             String       @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  sessionId      String?
  session        Session?     @relation(fields: [sessionId], references: [id])
  /// Estado de ánimo, 1 = muy triste … 5 = muy contento/a. NULL = no respondió.
  mood           Int?
  /// Cómo se siente con las matemáticas, 1 = muy nervioso/a … 5 = muy
  /// tranquilo/a. Es el inverso de la ansiedad matemática autorreportada
  /// (ansiedad = 6 − mathFeeling). NULL = no respondió.
  mathFeeling    Int?
  createdAt      DateTime     @default(now())
}

/// Registro auditable de cada cambio de dificultad. `ruleCode` identifica
/// la regla determinista aplicada (nunca una decisión opaca de IA).
model AdaptiveDecision {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id])
  ruleCode      String
  reason        String
  previousLevel Int
  newLevel      Int
  createdAt     DateTime @default(now())
}

/// Una estrella otorgada — siempre con un motivo trazable, nunca aleatorio
/// ni comprable con dinero real (reglas de gamificación del proyecto).
/// `reason` es un código cerrado: "correct_answer" | "pause_taken" |
/// "session_complete" | "streak_bonus" (bono aditivo por racha de aciertos
/// seguidos — nunca se resta al cortarse la racha).
model StarEvent {
  id             String       @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  sessionId      String?
  session        Session?     @relation(fields: [sessionId], references: [id])
  reason         String
  createdAt      DateTime     @default(now())
}

/// Fotografía de progreso personal — nunca comparado con otros estudiantes.
model ProgressSnapshot {
  id                 String       @id @default(cuid())
  childProfileId     String
  childProfile       ChildProfile @relation(fields: [childProfileId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  exercisesCompleted Int
  accuracyRate       Float
  createdAt          DateTime     @default(now())
}

/// Nota de una revisora sobre un ejercicio, escrita desde el modo revisión
/// (solo cuentas en REVIEWER_EMAILS). Es para corregir el banco después:
/// nunca la ve un niño ni afecta su progreso. `resolvedAt` lo marca quien
/// corrige el banco cuando la nota ya se atendió.
model ReviewComment {
  id          String    @id @default(cuid())
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  adultUserId String
  adultUser   AdultUser @relation(fields: [adultUserId], references: [id])
  text        String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([exerciseId])
}

/// Reflexión del niño al TERMINAR una práctica (specs/013): qué sintió
/// (siempre se pregunta) y una pregunta lúdica que rota entre clima,
/// energía y "lo más difícil". Todo opcional; una por sesión. Como la
/// sesión es de una habilidad, la emoción queda ligada al tema. Es un
/// autorreporte para acompañar en casa, nunca un diagnóstico.
model SessionReflection {
  id             String       @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  sessionId      String       @unique
  session        Session      @relation(fields: [sessionId], references: [id])
  mathSkillId    String?
  mathSkill      MathSkill?   @relation(fields: [mathSkillId], references: [id])
  /// Catálogo cerrado (domain/feelings.ts): orgullo, alegria, calma,
  /// aburrimiento, rabia, nervios. NULL = no respondió.
  emotion        String?
  /// Si la práctica fuera un clima: 1 = tormenta … 4 = sol.
  weather        Int?
  /// Energía que le puso: 1 = poquita … 3 = mucha.
  energy         Int?
  /// Lo más difícil: entender, cuentas, concentrarme, nada.
  hardest        String?
  createdAt      DateTime     @default(now())

  @@index([childProfileId, createdAt])
}

/// La familia marcó "¡Lo jugamos!" en un juego para la casa del panel.
model HomeGamePlay {
  id             String       @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  mathSkillId    String
  mathSkill      MathSkill    @relation(fields: [mathSkillId], references: [id])
  playedAt       DateTime     @default(now())

  @@index([childProfileId])
}

// ---------- Colegio (specs/014-paneles-escolares) ----------

/// Establecimiento. Lo crea una cuenta adulta, que queda como directiva;
/// el resto del personal se une con `staffCode`.
model School {
  id         String        @id @default(cuid())
  name       String
  /// Código para que docentes y directivos se unan al colegio.
  staffCode  String        @unique
  createdAt  DateTime      @default(now())
  staff      SchoolStaff[]
  classrooms Classroom[]
}

/// Rol de una cuenta adulta en un colegio: "director" (UTP/dirección, ve
/// todo el colegio AGREGADO) o "teacher" (ve sus cursos, por estudiante).
model SchoolStaff {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id])
  adultUserId String
  adultUser   AdultUser   @relation(fields: [adultUserId], references: [id])
  role        String
  /// Última vez que abrió su panel: indicador de adopción para directivos.
  lastPanelAt DateTime?
  createdAt   DateTime    @default(now())
  classrooms  Classroom[]

  @@unique([schoolId, adultUserId])
}

/// Curso de un colegio (p. ej. "3° B"), a cargo de una docente. Las familias
/// vinculan a su hijo/a con `joinCode`.
model Classroom {
  id          String            @id @default(cuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id])
  teacherId   String
  teacher     SchoolStaff       @relation(fields: [teacherId], references: [id])
  name        String
  grade       Int
  joinCode    String            @unique
  createdAt   DateTime          @default(now())
  enrollments ClassEnrollment[]
  notes       TeacherNote[]
}

/// Un niño en un curso. Unirse ES el consentimiento de la familia para
/// compartir su progreso académico con el colegio; `shareEmotions` es un
/// consentimiento APARTE para que la docente vea sus emociones individuales
/// (sin él, solo aporta al agregado del curso). `leftAt` = la familia lo
/// desvinculó (deja de verse en los paneles).
model ClassEnrollment {
  id             String       @id @default(cuid())
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  shareEmotions  Boolean      @default(false)
  consentedAt    DateTime     @default(now())
  leftAt         DateTime?

  @@unique([classroomId, childProfileId])
}

/// Nota privada de la docente sobre un estudiante (no la ve la familia).
model TeacherNote {
  id             String       @id @default(cuid())
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id])
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id])
  authorId       String
  author         AdultUser    @relation(fields: [authorId], references: [id])
  text           String
  createdAt      DateTime     @default(now())
}
