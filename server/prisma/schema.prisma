// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Adulto responsable (apoderado/docente) — único rol con credenciales en el MVP.
model AdultUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  consents     Consent[]
  children     ChildProfile[]
}

/// Consentimiento explícito de un adulto. Es obligatorio y precede a la
/// creación de cualquier perfil infantil (ver relación 1-a-1 en ChildProfile).
model Consent {
  id           String        @id @default(cuid())
  adultUserId  String
  adultUser    AdultUser     @relation(fields: [adultUserId], references: [id])
  scope        String
  grantedAt    DateTime      @default(now())
  revokedAt    DateTime?
  childProfile ChildProfile?
}

/// Perfil del estudiante. Datos mínimos: sin diagnósticos ni datos de salud.
model ChildProfile {
  id                String             @id @default(cuid())
  adultUserId       String
  adultUser         AdultUser          @relation(fields: [adultUserId], references: [id])
  consentId         String             @unique
  consent           Consent            @relation(fields: [consentId], references: [id])
  displayName       String
  /// MVP v1: fijo en 1° básico. Se guarda el valor real igualmente para no
  /// tener que migrar el esquema cuando se habiliten otros cursos.
  grade             Int
  language          String             @default("es")
  createdAt         DateTime           @default(now())
  sessions          Session[]
  progressSnapshots ProgressSnapshot[]
}

/// Patrón de error OBSERVABLE (nunca un diagnóstico clínico). Catálogo fijo,
/// sembrado por seed — ver regla del proyecto: "no interpretar un error como
/// prueba de déficit atencional".
model ErrorType {
  id          String           @id @default(cuid())
  code        String           @unique
  label       String
  description String
  options     ExerciseOption[]
  attempts    Attempt[]
}

/// Habilidad matemática. MVP v1: fija en 1° básico, eje Números y operaciones.
model MathSkill {
  id        String     @id @default(cuid())
  grade     Int
  axis      String
  name      String
  /// Código de Objetivo de Aprendizaje. NULL a propósito: no existe una fuente
  /// curricular oficial verificada en este entorno. No completar sin validar
  /// contra el documento oficial de MINEDUC.
  oaCode    String?
  exercises Exercise[]
}

/// Ejercicio. `isFictitious` marca explícitamente los datos de prueba —
/// nunca se presentan como contenido curricular real sin revisión.
model Exercise {
  id              String           @id @default(cuid())
  mathSkillId     String
  mathSkill       MathSkill        @relation(fields: [mathSkillId], references: [id])
  prompt          String
  /// Procedimiento o justificación esperada — trazabilidad pedagógica
  /// exigida por el proyecto para cada ejercicio.
  procedureNote   String
  /// Nivel de dificultad 1-3, usado por el motor adaptativo para pedir un
  /// ejercicio más fácil o más difícil. No confundir con `grade`.
  difficultyLevel Int              @default(2)
  isFictitious    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  options         ExerciseOption[]
  attempts        Attempt[]
}

/// Alternativa de un ejercicio. Si es incorrecta, puede señalar qué patrón
/// de error observable representa (opcional: no todas las opciones erróneas
/// están clasificadas todavía).
model ExerciseOption {
  id          String     @id @default(cuid())
  exerciseId  String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id])
  label       String
  isCorrect   Boolean
  errorTypeId String?
  errorType   ErrorType? @relation(fields: [errorTypeId], references: [id])
  attempts    Attempt[]
}

/// Una práctica corta (5-10 min) de un niño. Contenedor de intentos, pausas
/// y decisiones adaptativas.
model Session {
  id                String             @id @default(cuid())
  childProfileId    String
  childProfile      ChildProfile       @relation(fields: [childProfileId], references: [id])
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  attempts          Attempt[]
  pauseEvents       PauseEvent[]
  adaptiveDecisions AdaptiveDecision[]
}

/// Un intento de respuesta a un ejercicio dentro de una sesión.
/// `responseTimeMs` registra el patrón observable "respuesta excesivamente
/// rápida" sin interpretarlo como impulsividad ni déficit atencional.
model Attempt {
  id               String          @id @default(cuid())
  sessionId        String
  session          Session         @relation(fields: [sessionId], references: [id])
  exerciseId       String
  exercise         Exercise        @relation(fields: [exerciseId], references: [id])
  selectedOptionId String?
  selectedOption   ExerciseOption? @relation(fields: [selectedOptionId], references: [id])
  isCorrect        Boolean
  errorTypeId      String?
  errorType        ErrorType?      @relation(fields: [errorTypeId], references: [id])
  responseTimeMs   Int?
  attemptNumber    Int             @default(1)
  /// Cantidad de pistas usadas en este intento — insumo directo del motor
  /// adaptativo (regla "uso repetido de pistas").
  hintsUsed        Int             @default(0)
  createdAt        DateTime        @default(now())
  hints            Hint[]
}

/// Pista mostrada durante un intento. Progresiva: `level` 1, 2, 3…
model Hint {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  level     Int
  text      String
  shownAt   DateTime @default(now())
}

/// Pausa activa ofrecida durante una sesión. Siempre opcional — `accepted`
/// puede ser falso, la app nunca bloquea ni castiga por rechazarla.
model PauseEvent {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  kind       String
  offeredAt  DateTime @default(now())
  accepted   Boolean  @default(true)
  durationMs Int?
}

/// Registro auditable de cada cambio de dificultad. `ruleCode` identifica
/// la regla determinista aplicada (nunca una decisión opaca de IA).
model AdaptiveDecision {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id])
  ruleCode      String
  reason        String
  previousLevel Int
  newLevel      Int
  createdAt     DateTime @default(now())
}

/// Fotografía de progreso personal — nunca comparado con otros estudiantes.
model ProgressSnapshot {
  id                 String       @id @default(cuid())
  childProfileId     String
  childProfile       ChildProfile @relation(fields: [childProfileId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  exercisesCompleted Int
  accuracyRate       Float
  createdAt          DateTime     @default(now())
}
